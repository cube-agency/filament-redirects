{
    "name": "cube-agency/filament-redirects",
    "description": "Filament plugin for redirects management",
    "keywords": [
        "CubeAgency",
        "laravel",
        "filament",
        "filament-redirects"
    ],
    "homepage": "https://github.com/cube-agency/filament-redirects",
    "support": {
        "issues": "https://github.com/cube-agency/filament-redirects/issues",
        "source": "https://github.com/cube-agency/filament-redirects"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Kristaps Bajazitovs",
            "email": "kristaps.bajazitovs@cube.lv",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "CubeAgency\\FilamentRedirects\\": "src/",
            "CubeAgency\\FilamentRedirects\\Database\\Factories\\": "database/factories/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "CubeAgency\\FilamentRedirects\\FilamentRedirectsServiceProvider"
            ],
            "aliases": {
                "FilamentRedirects": "CubeAgency\\FilamentRedirects\\Facades\\FilamentRedirects"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
